<DetVarFiles>

	<!-- ===== numu1p channel (GUMP trees) ===== -->

	<!-- SBND: WM-Xtheta_xw_sbnd, matched to its own nominal -->
	<DetVarSection treename="SelectedEvents">
		<cv filename="{{ BASE_DIR }}/GUMP/sbruce_trees/SBND_WMXThetaXWNominal_sbruce.root" pot="1" />
		<variation name="WM-Xtheta_xw_sbnd" filename="{{ BASE_DIR }}/GUMP/sbruce_trees/SBND_WMXThetaXW_sbruce.root" pot="1" knobval="+1"/>

		<subchannel>nu_SBND_numu1p_cvcc</subchannel>
		<subchannel>nu_SBND_numu1p_cvnumunc</subchannel>
		<subchannel>nu_SBND_numu1p_cvothernc</subchannel>
		<subchannel>nu_SBND_numu1p_cvbkgcosmic</subchannel>
		<subchannel>nu_SBND_numu1p_cvbkgnotcosmic</subchannel>
	</DetVarSection>

	<!-- SBND: WM-YZ_sbnd, matched to its own nominal -->
	<DetVarSection treename="SelectedEvents">
		<cv filename="{{ BASE_DIR }}/GUMP/sbruce_trees/SBND_WMYZNominal_sbruce.root" pot="1" />
		<variation name="WM-YZ_sbnd" filename="{{ BASE_DIR }}/GUMP/sbruce_trees/SBND_WMYZ_sbruce.root" pot="1" knobval="+1"/>

		<subchannel>nu_SBND_numu1p_cvcc</subchannel>
		<subchannel>nu_SBND_numu1p_cvnumunc</subchannel>
		<subchannel>nu_SBND_numu1p_cvothernc</subchannel>
		<subchannel>nu_SBND_numu1p_cvbkgcosmic</subchannel>
		<subchannel>nu_SBND_numu1p_cvbkgnotcosmic</subchannel>
	</DetVarSection>

	<!-- SBND: Dent_sbnd, matched to its own nominal -->
	<DetVarSection treename="SelectedEvents">
		<cv filename="{{ BASE_DIR }}/GUMP/sbruce_trees/SBND_DENTNominal_sbruce.root" pot="1" />
		<variation name="Dent_sbnd" filename="{{ BASE_DIR }}/GUMP/sbruce_trees/SBND_DENT_sbruce.root" pot="1" knobval="+1"/>

		<subchannel>nu_SBND_numu1p_cvcc</subchannel>
		<subchannel>nu_SBND_numu1p_cvnumunc</subchannel>
		<subchannel>nu_SBND_numu1p_cvothernc</subchannel>
		<subchannel>nu_SBND_numu1p_cvbkgcosmic</subchannel>
		<subchannel>nu_SBND_numu1p_cvbkgnotcosmic</subchannel>
	</DetVarSection>

	<!-- SBND: variations derived from the unmatched CV (BIND is one knob shared by all detectors) -->
	<DetVarSection treename="SelectedEvents">
		<cv filename="{{ BASE_DIR }}/GUMP/sbruce_trees/SBND_BINDNominal_sbruce.root" pot="1" />
		<variation name="BIND" filename="{{ BASE_DIR }}/GUMP/sbruce_trees/SBND_BIND_sbruce.root" pot="1" knobval="+1"/>
		<variation name="Gain_sbnd" filename="{{ BASE_DIR }}/GUMP/sbruce_trees/SBND_GainHi_sbruce.root" pot="1" knobval="+1"/>
		<variation name="Gain_sbnd" filename="{{ BASE_DIR }}/GUMP/sbruce_trees/SBND_GainLow_sbruce.root" pot="1" knobval="-1"/>
