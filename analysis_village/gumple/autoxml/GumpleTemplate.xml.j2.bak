<?xml version="1.0" ?>

<mode name="nu" />

<detector name="SBND" pot="1e20"/>
<detector name="ICARUS" pot="5e20"/>

<channel name="numu1p" unit="Reconstructed Neutrino Energy [GeV]">
    <bins2D unit="RecoE;del_p" edgesx="0.3 0.4 0.45 0.5 0.55 0.6 0.65 0.7 0.75 0.8 0.85 0.9 0.95 1.0 1.5" edgesy="0.0 0.3 0.6"/>
    <bins unit = "True L/E" min="0" max="2.5" nbins="200" plot="false"/>
    <subchannel name="cvcc" plotname="#nu_{#mu}CC" color="#1e3f54"/>
    <subchannel name="cvnumunc" plotname="NuMuNC" color="#95af8b"/>
    <subchannel name="cvothernc" plotname="OtherNC" color="#A4459F"/>
    <subchannel name="cvbkgcosmic" plotname="Out of Time Cosmics" color="#c89648"/>
    <subchannel name="cvbkgnotcosmic" plotname="Other (Non-Cosmic)" color="#c89654"/>
    <subchannel name="cvbkg" plotname="Other" color="#c89648"/>
    <subchannel name="intime" plotname="In Time Cosmics" color="#500000"/>
    <subchannel name="dirt" plotname="Dirt" color="#CC5500"/>
    <subchannel name="Run2dirt" plotname="Run 2 Dirt" color="#CC5500"/>
    <subchannel name="Run4dirt" plotname="Run 4 Dirt" color="#CC5500"/>
</channel>

<channel name="numuMP" unit="Reconstructed Neutrino Energy [GeV]">
    <bins unit="RecoE" edges="0.3 0.5 0.55 0.6 0.65 0.7 0.75 0.8 0.85 0.9 0.95 1.0 1.05 1.10 1.25 1.5"/>
    <bins unit = "True L/E" min="0" max="2.5" nbins="200" plot="false"/>
    <subchannel name="cvcc" plotname="#nu_{#mu}CC" color="#1e3f54"/>
    <subchannel name="cvnumunc" plotname="NuMuNC" color="#95af8b"/>
    <subchannel name="cvothernc" plotname="OtherNC" color="#A4459F"/>
    <subchannel name="cvbkgcosmic" plotname="Out of Time Cosmics" color="#c89648"/>
    <subchannel name="cvbkgnotcosmic" plotname="Other (Non-Cosmic)" color="#c89654"/>
    <subchannel name="cvbkg" plotname="Other" color="#c89648"/>
    <subchannel name="intime" plotname="In Time Cosmics" color="#500000"/>
    <subchannel name="dirt" plotname="Dirt" color="#CC5500"/>
    <subchannel name="Run2dirt" plotname="Run 2 Dirt" color="#CC5500"/>
    <subchannel name="Run4dirt" plotname="Run 4 Dirt" color="#CC5500"/>
</channel>

<model tag="numudis">
    <rule index="0" name="No Osc"/>
    <rule index="1" name="Numu Disapp"/>
    <parameter variable_index = "1" name="L/E"/>
</model>


{% import "systematics.xml.j2" as syst with context %}
<variation_list>
    <systematic type="mcstat" plotname="MC Stats" >mcstats</systematic>
{{ syst.common_systematics }}

{{ syst.sbnd_systematics }}

{{ syst.icarus_r2_systematics }}

{{ syst.icarus_r4_systematics }}
</variation_list>

<MCFile treename="SelectedEvents" filename="{{ BASE_DIR }}/GUMP/FD/SBNDMCCV_*sbruce_fakedata.root" scale = "1.0" pot="{{ sbnd_mc_pot }}">
    <friend treename="multisigmaTree" />
    <friend treename="fakedataTree" />
    <friend treename="multisimTree" />
    <friend treename="fakedataTree" />
    <branch
        associated_subchannel = "nu_SBND_numu1p_cvcc"
        model_rule            = "1"
        additional_weight     = "(!true_isnc)*(true_pdg == 14 || true_pdg == -14)*cvwgt"
        >
        <variable2D>nu_E_calo;del_p</variable2D>
        <variable>baseline/(nu_E*1000.0)</variable>
    </branch>
    <branch
        associated_subchannel = "nu_SBND_numu1p_cvnumunc"
        model_rule            = "1"
        additional_weight     = "(true_isnc == 1)*(true_pdg == 14 || true_pdg == -14)*cvwgt"
        >
        <variable2D>nu_E_calo;del_p</variable2D>
	<variable>baseline/(nu_E*1000.0)</variable>
    </branch>

    <branch
        associated_subchannel = "nu_SBND_numu1p_cvothernc"
        model_rule            = "0"
        additional_weight     = "(true_isnc == 1)*(true_pdg != 14 & true_pdg != -14)*cvwgt"
        >
        <variable2D>nu_E_calo;del_p</variable2D>
	<variable>baseline/(nu_E*1000.0)</variable>
    </branch>
    <branch
        associated_subchannel = "nu_SBND_numu1p_cvbkgcosmic"
        model_rule            = "0"
        additional_weight     = "(!((true_isnc != 1)*(true_pdg == 14 || true_pdg == -14)) & !(true_isnc == 1) & (true_iscosmic == 1))*cvwgt"
        >
        <variable2D>nu_E_calo;del_p</variable2D>
	<variable>1.0</variable>
    </branch>
    <branch
        associated_subchannel = "nu_SBND_numu1p_cvbkgnotcosmic"
        model_rule            = "0"
        additional_weight     = "(!((true_isnc != 1)*(true_pdg == 14 || true_pdg == -14)) & !(true_isnc == 1) & !(true_iscosmic == 1))*cvwgt"
        >
        <variable2D>nu_E_calo;del_p</variable2D>
	<variable>1.0</variable>
    </branch>
</MCFile>

<MCFile treename="SelectedEvents" filename="{{ BASE_DIR }}/GUMP/FD/SBND_SpringBNBOffData_sbruce_fakedata.root" scale = "1.0" pot="{{ sbnd_offbeam_pot }}">
    <branch
        associated_subchannel = "nu_SBND_numu1p_intime"
        model_rule            = "0"
        incl_systematics      = "false"
        >
        <variable2D>nu_E_calo;del_p</variable2D>
	<variable>1.0</variable>
    </branch>
</MCFile>

<MCFile treename="SelectedEvents" filename="{{ BASE_DIR }}/GUMP/FD/SBND_SpringLowEMC_sbruce_fakedata.root" scale = "1.0" pot="{{ sbnd_dirt_pot }}">
