diff --git a/analysis_village/gumple/autoxml/systematics.xml.j2 b/analysis_village/gumple/autoxml/systematics.xml.j2
new file mode 100644
index 0000000..6dbff7e
--- /dev/null
+++ b/analysis_village/gumple/autoxml/systematics.xml.j2
@@ -0,0 +1,203 @@
+{%#
+    Shared systematics list for every template in autoxml/.
+
+    Each template pulls this in just above its <variation_list> with
+
+        {% import "systematics.xml.j2" as syst with context %}
+
+    and then pastes in the blocks it needs:
+
+        {{ syst.common_systematics }}      all detectors / runs (xsec, G4, flux, BIND)
+        {{ syst.sbnd_systematics }}        SBND only (detector, dirt, cosmics, POT)
+        {{ syst.icarus_r2_systematics }}   ICARUS Run 2 only (detector, dirt, POT)
+        {{ syst.icarus_r4_systematics }}   ICARUS Run 4 only (detector, dirt, POT)
+
+    Subchannel naming is not the same in every template, so the patterns the
+    systematics attach to are variables. The defaults below match the joint
+    templates (GumpleTemplate, GumpTemplate, MapleNPTemplate). A template
+    with different subchannel names overrides them with {% set %} *before*
+    the import, e.g. the DataMC/ templates.
+#%}
+{%# -- Patterns: override any of these with {% set %} before importing -- #%}
+{% set syst_xsec_subchannels          = syst_xsec_subchannels          | default("numu.*_cv.*") %}
+{% set syst_sbnd_det_subchannels      = syst_sbnd_det_subchannels      | default("nu_SBND_numu.*_cv.*") %}
+{% set syst_icarus_r2_det_subchannels = syst_icarus_r2_det_subchannels | default("nu_ICARUS_numu.*_cv.*") %}
+{% set syst_icarus_r4_det_subchannels = syst_icarus_r4_det_subchannels | default("nu_ICARUS_numu.*_cv.*") %}
+{% set syst_sbnd_cosmic_subchannel    = syst_sbnd_cosmic_subchannel    | default("nu_SBND_numu.*_cvbkgcosmic") %}
+{% set syst_sbnd_dirt_subchannel      = syst_sbnd_dirt_subchannel      | default("nu_SBND_numu.*_dirt") %}
+{% set syst_icarus_r2_dirt_subchannel = syst_icarus_r2_dirt_subchannel | default("nu_ICARUS_numu.*_Run2dirt") %}
+{% set syst_icarus_r4_dirt_subchannel = syst_icarus_r4_dirt_subchannel | default("nu_ICARUS_numu.*_Run4dirt") %}
+{%# Binning for the xsec / G4 reweights, e.g. "var2" to bin in true energy. Empty = fit variable. #%}
+{% set syst_xsec_binning              = syst_xsec_binning              | default("") %}
+{% set _xsec_binning = (' binning="' ~ syst_xsec_binning ~ '"') if syst_xsec_binning else "" %}
+
+{%# ===================== All detectors / runs ===================== #%}
+{% set common_systematics %}
+    <systematic type="spline" tag="SF" apply_to_subchannel="{{ syst_xsec_subchannels }}"{{ _xsec_binning }} plotname="Spectral Function Bin 0">multisigma_CCQETemplateReweight_SBN_v3_LFGToSF_q0bin0</systematic>
+    <systematic type="spline" tag="SF" apply_to_subchannel="{{ syst_xsec_subchannels }}"{{ _xsec_binning }} plotname="Spectral Function Bin 1">multisigma_CCQETemplateReweight_SBN_v3_LFGToSF_q0bin1</systematic>
+    <systematic type="spline" tag="SF" apply_to_subchannel="{{ syst_xsec_subchannels }}"{{ _xsec_binning }} plotname="Spectral Function Bin 2">multisigma_CCQETemplateReweight_SBN_v3_LFGToSF_q0bin2</systematic>
+    <systematic type="spline" tag="SF" apply_to_subchannel="{{ syst_xsec_subchannels }}"{{ _xsec_binning }} plotname="Spectral Function Bin 3">multisigma_CCQETemplateReweight_SBN_v3_LFGToSF_q0bin3</systematic>
+    <systematic type="spline" tag="SF" apply_to_subchannel="{{ syst_xsec_subchannels }}"{{ _xsec_binning }} plotname="Spectral Function Bin 4">multisigma_CCQETemplateReweight_SBN_v3_LFGToSF_q0bin4</systematic>
+
