<?xml version="1.0" ?>

<mode name="nu" />

<!--detector name="ICARUS4" pot="2e20"/-->
<detector name="ICARUS2" pot="{{ icarus_r2_data_pot }}"/>

<!--detector name="SBND" pot="4.57e18"/--> 

<!--
<detector name="SBND" pot="4.57e18"/>
<detector name="ICARUS2" pot="1.985e19"/>
<detector name="ICARUS4" pot="1.916e19"/>
-->
<channel name="numu" unit="Reconstructed Neutrino Energy [GeV]">
    <!--bins unit="RecoE" edges="0.3 0.4 0.45 0.5 0.55 0.6 0.65 0.7 0.75 0.8 0.85 0.9 0.95 1.0 1.5"/-->
    BINS
    <bins unit = "True L/E" min="0" max="3" nbins="250" plot="false"/>
    <bins unit = "True E [GeV]" min="0.3" max="3.0" nbins="20"  plot="false"/>

    <subchannel name="Run2intime"    plotname="Intime"        color="#E570FF"/>
    <subchannel name="Run2dirt"    plotname="Dirt"        color="#FF6961"/>
    <subchannel name="Run2cos"    plotname="OOT"        color="#E37400"/> 
    <subchannel name="Run2numunc"     plotname="#nu_{#mu}NC"             color="#0645F4"/> 
    <subchannel name="Run2nue"  plotname="#nu_{e}"     color="#34A853"/>
    <subchannel name="Run2numucc" plotname="#nu_{#mu}CC"   color="#99CCFF"/>

</channel>

<model tag="SBL_2flav_numudis">
    <rule index="0" name="No Osc"/>
    <rule index="1" name="Numu Disapp"/>
    <parameter variable_index = "1" name="L/E"/>
</model>



<MCFile treename="SelectedEvents" filename="{{ BASE_DIR }}/MAPLEMP/ICARUSRun2_SpringMCOverlay_rewgt_*_sbruce.root" scale = "1" pot="{{ icarus_r2_mc_pot }}">  <!-- 2.172e21 -->
    <friend treename="multisigmaTree" />
    <friend treename="multisimTree" />
    <branch
        associated_subchannel = "nu_ICARUS2_numu_Run2numucc"
        model_rule            = "1"
        additional_weight     = "((!true_isnc) && (true_pdg == 14 || true_pdg == -14))*cvwgt"
        >
        <variable>BRANCH</variable>
        <variable>baseline/(nu_E*1000.0)</variable>
	    <variable>nu_E</variable>

    </branch>
    <branch
        associated_subchannel = "nu_ICARUS2_numu_Run2numunc"
        model_rule            = "1"
        additional_weight     = "((true_isnc == 1) && (true_pdg == 14 || true_pdg == -14))*cvwgt"
        >
        <variable>BRANCH</variable>
        <variable>baseline/(nu_E*1000.0)</variable>
	    <variable>nu_E</variable>

    </branch>
    <branch
        associated_subchannel = "nu_ICARUS2_numu_Run2nue"
        model_rule            = "0"
        additional_weight     = "((true_pdg == 12 || true_pdg == -12))*cvwgt"
        >
        <variable>BRANCH</variable>
        <variable>baseline/(nu_E*1000.0)</variable>
	    <variable>nu_E</variable>

    </branch>    
    <branch
        associated_subchannel = "nu_ICARUS2_numu_Run2cos"
        model_rule            = "0"
        additional_weight     = "(true_iscosmic == 1)*cvwgt"
        >
        <variable>BRANCH</variable>
	    <variable>0.0</variable>
	    <variable>0.0</variable>

    </branch>
</MCFile>

<MCFile treename="SelectedEvents" filename="{{ BASE_DIR }}/MAPLEMP/ICARUS_SpringRun2BNBOff_unblind_sbruce.root" scale = "1" pot="{{ icarus_r2_offbeam_pot }}"> <!-- 4.024e19-->
    <branch
        associated_subchannel = "nu_ICARUS2_numu_Run2intime"
        model_rule            = "0"
        incl_systematics      = "false"
        >
        <variable>BRANCH</variable>
	    <variable>0.0</variable>
	    <variable>0.0</variable>

    </branch>
</MCFile>

<MCFile treename="SelectedEvents" filename="{{ BASE_DIR }}/MAPLEMP/ICARUSRun2_Spring_Overlay_Dirt_sbruce.root" scale = "1" pot="{{ icarus_r2_dirt_pot }}"> <!-- 1.683e21-->
    <branch
        associated_subchannel = "nu_ICARUS2_numu_Run2dirt"
        model_rule            = "0"
        incl_systematics      = "true"
        >
        <variable>BRANCH</variable>
	    <variable>0.0</variable>
	    <variable>0.0</variable>

    </branch>
</MCFile>

<DetVarFiles>


	<DetVarSection treename="SelectedEvents">
	<!--DetVarSection treename="events/selectedAll" cv_variation_matching_vars="Run,Subrun,Evt" extra_weight="selected"-->

		<cv filename="{{ BASE_DIR }}/MAPLEMP/sbruce_trees/ICARUSRun2_WMXThetaXWNominal_sbruce.root" pot="1" />
        <variation name="WM-Xtheta_xw_icarus2"    filename="{{ BASE_DIR }}/MAPLEMP/sbruce_trees/ICARUSRun2_WMXThetaXW_sbruce.root" pot="1" knobval="+1"/>    <!-- 1.2245e21 -->

		<subchannel>nu_ICARUS2_numu_Run2intime</subchannel>
		<subchannel>nu_ICARUS2_numu_Run2dirt</subchannel>
		<subchannel>nu_ICARUS2_numu_Run2cos</subchannel>
		<subchannel>nu_ICARUS2_numu_Run2numunc</subchannel>
		<subchannel>nu_ICARUS2_numu_Run2nue</subchannel> 
        <subchannel>nu_ICARUS2_numu_Run2numucc</subchannel>

	</DetVarSection>

	<DetVarSection treename="SelectedEvents">
	<!--DetVarSection treename="events/selectedAll" cv_variation_matching_vars="Run,Subrun,Evt" extra_weight="selected"-->

		<cv filename="{{ BASE_DIR }}/MAPLEMP/sbruce_trees/ICARUSRun2_WMYZNominal_sbruce.root" pot="1" />
        <variation name="WM-YZ_icarus2"    filename="{{ BASE_DIR }}/MAPLEMP/sbruce_trees/ICARUSRun2_WMYZ_sbruce.root" pot="1" knobval="+1"/>                 <!-- 2.1768e21 -->

		<subchannel>nu_ICARUS2_numu_Run2intime</subchannel>
		<subchannel>nu_ICARUS2_numu_Run2dirt</subchannel>
		<subchannel>nu_ICARUS2_numu_Run2cos</subchannel>
		<subchannel>nu_ICARUS2_numu_Run2numunc</subchannel>
		<subchannel>nu_ICARUS2_numu_Run2nue</subchannel> 
        <subchannel>nu_ICARUS2_numu_Run2numucc</subchannel>

	</DetVarSection>


	<DetVarSection treename="SelectedEvents">
	<!--DetVarSection treename="events/selectedAll" cv_variation_matching_vars="Run,Subrun,Evt" extra_weight="selected"-->

		<cv filename="{{ BASE_DIR }}/MAPLEMP/sbruce_trees/ICARUSRun2_SCENominal_sbruce.root" pot="1" />
        <variation name="SCE_icarus2"    filename="{{ BASE_DIR }}/MAPLEMP/sbruce_trees/ICARUSRun2_SCE_sbruce.root" pot="1" knobval="+1"/>                    <!-- 2.1717e21 -->

		<subchannel>nu_ICARUS2_numu_Run2intime</subchannel>
		<subchannel>nu_ICARUS2_numu_Run2dirt</subchannel>
		<subchannel>nu_ICARUS2_numu_Run2cos</subchannel>
		<subchannel>nu_ICARUS2_numu_Run2numunc</subchannel>
		<subchannel>nu_ICARUS2_numu_Run2nue</subchannel> 
        <subchannel>nu_ICARUS2_numu_Run2numucc</subchannel>

	</DetVarSection>

	<DetVarSection treename="SelectedEvents">
	<!--DetVarSection treename="events/selectedAll" cv_variation_matching_vars="Run,Subrun,Evt" extra_weight="selected"-->

		<cv filename="{{ BASE_DIR }}/MAPLEMP/sbruce_trees/ICARUSRun2_BINDNominal_sbruce.root" pot="1" />
        <variation name="WCathode_icarus2"    filename="{{ BASE_DIR }}/MAPLEMP/sbruce_trees/ICARUSRun2_WestCathode_TRKSPLT_sbruce.root" pot="1" knobval="+1"/>
        <variation name="ECathode_icarus2"    filename="{{ BASE_DIR }}/MAPLEMP/sbruce_trees/ICARUSRun2_EastCathode_TRKSPLT_sbruce.root" pot="1" knobval="+1"/>
        <variation name="z0_icarus2"    filename="{{ BASE_DIR }}/MAPLEMP/sbruce_trees/ICARUSRun2_Z=0_TRKSPLT_sbruce.root" pot="1" knobval="+1"/>
        <variation name="Gain_icarus2"    filename="{{ BASE_DIR }}/MAPLEMP/sbruce_trees/ICARUSRun2_GainHi_sbruce.root" pot="1" knobval="+1"/>
        <variation name="Gain_icarus2"    filename="{{ BASE_DIR }}/MAPLEMP/sbruce_trees/ICARUSRun2_GainLow_sbruce.root" pot="1" knobval="-1"/>
        <variation name="Smear_icarus2"    filename="{{ BASE_DIR }}/MAPLEMP/sbruce_trees/ICARUSRun2_SmeareddEdx_sbruce.root" pot="1" knobval="+1"/>
        <variation name="BiasdEdx_icarus2"    filename="{{ BASE_DIR }}/MAPLEMP/sbruce_trees/ICARUSRun2_BiaseddEdx_sbruce.root" pot="1" knobval="+1"/>
        <variation name="Trigger_icarus2"    filename="{{ BASE_DIR }}/MAPLEMP/sbruce_trees/ICARUSRun2_TrigEffPls_sbruce.root" pot="1" knobval="+1"/>
        <variation name="Trigger_icarus2"    filename="{{ BASE_DIR }}/MAPLEMP/sbruce_trees/ICARUSRun2_TrigEffMin_sbruce.root" pot="1" knobval="-1"/>
        <variation name="BIND"    filename="{{ BASE_DIR }}/MAPLEMP/sbruce_trees/ICARUSRun2_BIND_sbruce.root" pot="1" knobval="+1"/>

		<subchannel>nu_ICARUS2_numu_Run2intime</subchannel>
		<subchannel>nu_ICARUS2_numu_Run2dirt</subchannel>
		<subchannel>nu_ICARUS2_numu_Run2cos</subchannel>
		<subchannel>nu_ICARUS2_numu_Run2numunc</subchannel>
		<subchannel>nu_ICARUS2_numu_Run2nue</subchannel> 
        <subchannel>nu_ICARUS2_numu_Run2numucc</subchannel>


	</DetVarSection>

</DetVarFiles>



